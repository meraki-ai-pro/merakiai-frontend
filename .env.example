# Browser-to-backend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
# Recommended on Vercel: route HTTP through the same-origin Next.js proxy.
NEXT_PUBLIC_API_BASE=/api/backend
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_DEBUG_BACKEND=false

# Supabase public project settings (never use the service-role key here)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
