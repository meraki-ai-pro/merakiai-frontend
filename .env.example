# Browser-to-backend configuration
NEXT_PUBLIC_API_URL=your-backend-url
NEXT_PUBLIC_WS_URL=ws://your-backend-url

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Authentication
NEXTAUTH_SECRET=your-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# hCaptcha on sign-up, sign-in, forgot-password and change-password.
# Public site key from dashboard.hcaptcha.com. Leave empty to hide the widget.
# The secret never goes here: paste it into Supabase > Authentication >
# Bot and Abuse Protection, which verifies every token.
# Local testing: hCaptcha publishes an always-pass test key,
# 10000000-ffff-ffff-ffff-000000000001.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
