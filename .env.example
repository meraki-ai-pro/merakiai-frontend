# Browser-to-backend configuration
NEXT_PUBLIC_API_URL=your-backend-url
NEXT_PUBLIC_WS_URL=ws://your-backend-url

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Authentication
NEXTAUTH_SECRET=your-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare Turnstile on sign-up, sign-in, forgot-password and change-password.
# Public site key from Cloudflare dashboard > Turnstile. Leave empty to hide the
# widget. The secret key never goes here: paste it into Supabase >
# Authentication > Bot and Abuse Protection (provider: Turnstile), which
# verifies every token.
# Local testing: Cloudflare publishes an always-pass test site key,
# 1x00000000000000000000AA.
NEXT_TURNSTILE_SITE_KEY=
