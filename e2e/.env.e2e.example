# Walkthrough account credentials.
#
# Copy to e2e/.env.e2e (gitignored) and fill in. These are real accounts on the
# Supabase project, which is why they are not committed. Create them with the
# same values using the backend's scripts/seed_accounts.py, which reads these
# variables too.
#
# Emails default to the e2e.*@ug.edu.gh addresses and only need setting if you
# want different ones.

E2E_LECTURER_PASSWORD=
E2E_STUDENT1_PASSWORD=
E2E_STUDENT2_PASSWORD=

# E2E_LECTURER_EMAIL=e2e.lecturer@ug.edu.gh
# E2E_STUDENT1_EMAIL=e2e.student1@ug.edu.gh
# E2E_STUDENT2_EMAIL=e2e.student2@ug.edu.gh
